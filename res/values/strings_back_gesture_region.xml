<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title for adjusting which vertical region can trigger the back gesture. [CHAR LIMIT=60] -->
    <string name="back_gesture_regions_title">Back gesture regions</string>
    <!-- Accessibility state for the selected back gesture region. [CHAR LIMIT=60] -->
    <string name="back_gesture_region_state_description"><xliff:g id="top_percentage" example="15%">%1$s</xliff:g> to <xliff:g id="bottom_percentage" example="75%">%2$s</xliff:g></string>
</resources>
