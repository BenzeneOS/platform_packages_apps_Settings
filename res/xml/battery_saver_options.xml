<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="battery_saver_options"
    android:title="@string/battery_saver_options_title">

    <!-- Display Category -->
    <PreferenceCategory
        android:key="battery_saver_display_category"
        android:title="@string/battery_saver_category_display">

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_animation"
            android:title="@string/battery_saver_allow_animation_title"
            android:summary="@string/battery_saver_allow_animation_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="battery_saver_refresh_rate"
            android:title="@string/battery_saver_refresh_rate_title"
            android:summary="@string/battery_saver_refresh_rate_summary"
            android:entries="@array/battery_saver_refresh_rate_entries"
            android:entryValues="@array/battery_saver_refresh_rate_values"
            android:defaultValue="0" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_blur"
            android:title="@string/battery_saver_allow_blur_title"
            android:summary="@string/battery_saver_allow_blur_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_hbm"
            android:title="@string/battery_saver_allow_hbm_title"
            android:summary="@string/battery_saver_allow_hbm_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_aod"
            android:title="@string/battery_saver_allow_aod_title"
            android:summary="@string/battery_saver_allow_aod_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_night_mode_off"
            android:title="@string/battery_saver_allow_night_mode_off_title"
            android:summary="@string/battery_saver_allow_night_mode_off_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_brightness"
            android:title="@string/battery_saver_allow_brightness_title"
            android:summary="@string/battery_saver_allow_brightness_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Performance Category -->
    <PreferenceCategory
        android:key="battery_saver_performance_category"
        android:title="@string/battery_saver_category_performance">

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_launch_boost"
            android:title="@string/battery_saver_allow_launch_boost_title"
            android:summary="@string/battery_saver_allow_launch_boost_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_standby"
            android:title="@string/battery_saver_allow_standby_title"
            android:summary="@string/battery_saver_allow_standby_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_background"
            android:title="@string/battery_saver_allow_background_title"
            android:summary="@string/battery_saver_allow_background_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_disable_quick_doze"
            android:title="@string/battery_saver_disable_quick_doze_title"
            android:summary="@string/battery_saver_disable_quick_doze_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Network Category -->
    <PreferenceCategory
        android:key="battery_saver_network_category"
        android:title="@string/battery_saver_category_network">

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_network"
            android:title="@string/battery_saver_allow_network_title"
            android:summary="@string/battery_saver_allow_network_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_data"
            android:title="@string/battery_saver_allow_data_title"
            android:summary="@string/battery_saver_allow_data_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Sensors Category -->
    <PreferenceCategory
        android:key="battery_saver_sensors_category"
        android:title="@string/battery_saver_category_sensors">

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_vibration"
            android:title="@string/battery_saver_allow_vibration_title"
            android:summary="@string/battery_saver_allow_vibration_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_soundtrigger"
            android:title="@string/battery_saver_allow_soundtrigger_title"
            android:summary="@string/battery_saver_allow_soundtrigger_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_sensors"
            android:title="@string/battery_saver_allow_sensors_title"
            android:summary="@string/battery_saver_allow_sensors_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_attention"
            android:title="@string/battery_saver_allow_attention_title"
            android:summary="@string/battery_saver_allow_attention_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_camera_rotate"
            android:title="@string/battery_saver_allow_camera_rotate_title"
            android:summary="@string/battery_saver_allow_camera_rotate_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Background Tasks Category -->
    <PreferenceCategory
        android:key="battery_saver_background_category"
        android:title="@string/battery_saver_category_background">

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_full_backup"
            android:title="@string/battery_saver_allow_full_backup_title"
            android:summary="@string/battery_saver_allow_full_backup_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_kv_backup"
            android:title="@string/battery_saver_allow_kv_backup_title"
            android:summary="@string/battery_saver_allow_kv_backup_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Location Category -->
    <PreferenceCategory
        android:key="battery_saver_location_category"
        android:title="@string/battery_saver_category_location">

        <SwitchPreferenceCompat
            android:key="battery_saver_allow_location"
            android:title="@string/battery_saver_allow_location_title"
            android:summary="@string/battery_saver_allow_location_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
