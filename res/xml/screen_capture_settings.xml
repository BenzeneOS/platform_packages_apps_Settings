<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="screen_capture_settings"
    android:title="@string/screen_capture_privacy_title">

    <SwitchPreferenceCompat
        android:key="disable_secure_windows"
        android:title="@string/bypass_flag_secure_title"
        android:summary="@string/bypass_flag_secure_summary"
        settings:controller="com.android.settings.privacy.BypassFlagSecureController"/>

    <SwitchPreferenceCompat
        android:key="hide_screen_capture_status"
        android:title="@string/hide_screen_capture_title"
        android:summary="@string/hide_screen_capture_summary"
        settings:controller="com.android.settings.privacy.HideScreenCaptureStatusController"/>

</PreferenceScreen>
